APP_NAME="Sistema de Transporte Asamblea Legislativa"
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://CHANGE_ME.your-domain.com
ASSET_URL=https://CHANGE_ME.your-domain.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

FRONTEND_URL=https://CHANGE_ME.your-domain.com

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME_DB_HOST
DB_PORT=3306
DB_DATABASE=transporte_asamblea
DB_USERNAME=CHANGE_ME_DB_USERNAME
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# Sessions (Filament usa sesión web)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=CHANGE_ME_SESSION_DOMAIN
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache / Queue (Redis)
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Broadcasting / Realtime (Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=CHANGE_ME.your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY=${REVERB_APP_KEY}
VITE_REVERB_HOST=CHANGE_ME.your-domain.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=CHANGE_ME_REDIS_HOST
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME_MAIL_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_MAIL_USERNAME
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="CHANGE_ME_MAIL_FROM_ADDRESS"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=CHANGE_ME
AWS_USE_PATH_STYLE_ENDPOINT=false

# LDAP
LDAP_ENABLED=true
LDAP_HOST=CHANGE_ME_LDAP_HOST
LDAP_PORT=636
LDAP_BASE_DN=CHANGE_ME_LDAP_BASE_DN
LDAP_USERNAME=CHANGE_ME_LDAP_USERNAME
LDAP_PASSWORD=CHANGE_ME_LDAP_PASSWORD
LDAP_SSL=true

# Sanctum
SANCTUM_STATEFUL_DOMAINS=CHANGE_ME.your-domain.com

VITE_APP_NAME="${APP_NAME}"
